{
  "name": "dementeking",
  "version": "0.1.0",
  "private": true,
  "description": "Agente autónomo que opera en simulación (paper trading) con datos de mercado reales",
  "type": "module",
  "scripts": {
    "mission": "tsx src/mission.ts",
    "agent": "tsx src/run.ts",
    "report": "tsx src/report.ts",
    "watcher": "tsx src/watcher.ts",
    "dashboard": "tsx src/dashboard/cli.ts",
    "signer": "tsx src/live/signer/main.ts",
    "reset": "tsx src/reset.ts",
    "typecheck": "tsc --noEmit",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test": "tsx --test --import ./test/setup.ts \"test/**/*.test.ts\"",
    "install:opencode": "npm run build:plugin && tsx scripts/install-opencode.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^18.0.4",
    "playwright": "^1.63.0",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
